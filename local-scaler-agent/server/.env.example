PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# ---- Text + SVG model: set ONE of these (first one found is used; LLM_PROVIDER can force one) ----
# Option A (recommended): Google AI Studio key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
# Option B: OpenRouter key -> https://openrouter.ai/keys  (model "Google: Gemma 4 26B A4B")
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# Option C: Anthropic key (must start with sk-ant-)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional: gemini | openrouter | anthropic
LLM_PROVIDER=

# Optional: real PNG images. Gemma/Claude cannot generate raster images; OpenAI can.
# Without it, the dashboard draws an SVG infographic with your LLM (or offline).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

